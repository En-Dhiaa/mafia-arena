# ==========================================
# MAFIA ARENA — ENVIRONMENT VARIABLES
# ==========================================

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Secret Key (NEVER expose in client-side code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional Admin Setup Key (Used to initialize the first super-admin securely)
ADMIN_SETUP_SECRET=change-this-in-production-to-a-secure-secret

# Node Environment
NODE_ENV=development

